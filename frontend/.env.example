# Copy from backend/.env: must match CHAIN_REGISTRY_ADDRESS exactly,
# otherwise the address MetaMask signs to will not match the contract
# the backend independently reads from. Same-port, same-contract rule
# that backend/CLAUDE.md spells out for WEB3_RPC_URL applies here.
#
# This file is loaded by Vite automatically — never commit a real
# address; this template just shows the shape.
VITE_CHAIN_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000