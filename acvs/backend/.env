# --- Django -----------------------------------------------------------------
SECRET_KEY=replace-me-in-production
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- PostgreSQL -------------------------------------------------------------
# Production target. Use a real Postgres server and put credentials here.
# Local install: install Postgres 16, then `createdb acvs` and `createuser acvs`.
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=acvs_dev
PGUSER=acvs_user
PGPASSWORD=devpassword

# --- Email ------------------------------------------------------------------
DEFAULT_FROM_EMAIL=no-reply@acvs.local

# --- Frontend ---------------------------------------------------------------
# Base URL the password-reset email links to. Must match the dev server
# that actually serves the SPA (Vite defaults to 5173). The reset link
# shape is `${FRONTEND_URL}/reset-password/confirm?uid=...&token=...` —
# see accounts/views.py:_send_reset_email.
FRONTEND_URL=http://localhost:5173

# --- Chain / web3 -----------------------------------------------------------
# Ganache local defaults; leave CHAIN_REGISTRY_ADDRESS empty until the
# contract is deployed. Copy the deployed address here after `truffle migrate`.
# WEB3_RPC_TIMEOUT is in seconds; bump for a slow public RPC.
# Ganache returns eth_blockNumber immediately but takes much longer on
# the contract call — 3s reliably times out on a healthy Ganache
# against a real ABI, returning chain_state="unreachable" for certs
# that are perfectly readable. 30s is comfortably above any local
# latency we'd see.
WEB3_RPC_URL=http://127.0.0.1:7545
WEB3_RPC_TIMEOUT=30
CHAIN_REGISTRY_ADDRESS=0xE344CAad76001912b84e560ECD54b8817c0eab78
